{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "../../out/main",
    "baseUrl": ".",
    "paths": {
      "@main/*": ["./*"]
    }
  },
  "include": ["./**/*.ts"]
}
